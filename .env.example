# Optional — only needed for `ziwei read` (the AI interpretation command).
# The `ziwei chart` command needs NONE of these (the chart engine is offline).
#
# Works with any OpenAI-compatible endpoint (OpenAI, DeepSeek, Together, Groq,
# a local server, ...). Copy this file to `.env` and fill in your own key.

TUVI_AI_API_KEY=
TUVI_AI_BASE_URL=https://api.openai.com/v1
TUVI_AI_MODEL=gpt-4o-mini
