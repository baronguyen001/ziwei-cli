{
  "name": "ziwei-cli",
  "version": "0.3.0",
  "description": "Zi Wei Dou Shu (紫微斗数 / Tử Vi Đẩu Số) natal chart calculator — TypeScript library + CLI with an optional OpenAI-compatible AI reading.",
  "keywords": [
    "ziwei",
    "zi-wei-dou-shu",
    "tuvi",
    "astrology",
    "natal-chart",
    "iztro",
    "cli",
    "typescript"
  ],
  "license": "MIT",
  "author": "baronguyen001",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ziwei": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "ziwei": "tsx src/cli.ts"
  },
  "dependencies": {
    "iztro": "^2.4.5",
    "openai": "^4.77.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
